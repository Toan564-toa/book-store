{
  "name": "book-store-api",
  "version": "1.0.0",
  "description": "Basic Book Store API with authentication, books, cart, orders, reviews and wishlist.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:refresh": "tsx src/scripts/refresh-real-catalog.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nodejs",
    "express",
    "book-store-api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.3",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.4",
    "tsx": "^4.23.12"
  }
}
